# Database
POSTGRES_USER=chinese_admin
# ⚠️ Set a strong password for production (openssl rand -base64 24)
POSTGRES_PASSWORD=chinese_pass
POSTGRES_DB=chinese_learning

# JWT
# ⚠️ IMPORTANT: Change this to a strong random string for production!
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
# Refresh token lifetime = login session length (frontend auto-refreshes
# the access token while the refresh token is still valid).
REFRESH_TOKEN_EXPIRES_IN=7d
# Auth cookie Secure flag override. Leave EMPTY for HTTPS deployments
# (auto-secure in production). Set to "false" ONLY for a temporary
# HTTP-only deployment — passwords then travel unencrypted.
COOKIE_SECURE=

# Server
PORT=3000
NODE_ENV=production

# Frontend (not used in production - nginx serves static files)
VITE_API_URL=http://localhost:3000

# Azure Neural TTS (optional — empty key = TTS disabled, app falls back to Web Speech)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Speaker → voice overrides, format "A:zh-CN-XiaoxiaoNeural,B:zh-CN-YunxiNeural" (optional)
TTS_VOICE_MAP=
# Pause between dialogue turns in ms (optional, default 300)
TTS_PAUSE_MS=
# Audio storage dir (optional, default <backend>/storage/tts)
TTS_STORAGE_DIR=
