generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  username           String                   @unique
  passwordHash       String
  avatar             String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?
  refreshTokens        RefreshToken[]
  userProgress         UserProgress[]
  vocabularyProgress   UserVocabularyProgress[]
  dialogueProgress     UserDialogueProgress[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Multi-source learning course: built-in HSK levels ("HSK") and imported
// custom textbooks ("CUSTOM"). Table name kept as hsk_levels for continuity.
model Course {
  id          String   @id @default(cuid())
  level       Int
  type        String   @default("HSK")
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]

  @@index([type, level])
  @@map("hsk_levels")
}

model Lesson {
  id                String                 @id @default(cuid())
  courseId          String
  title             String
  description       String?
  order             Int
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  course            Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userProgress      UserProgress[]
  vocabularies      Vocabulary[]
  conversations     Conversation[]
  dialogueProgress  UserDialogueProgress[]

  @@map("lessons")
}

model Vocabulary {
  id           String                   @id @default(cuid())
  lessonId     String
  hanzi        String
  traditional  String?
  pinyin       String
  meaning      String
  audioUrl     String?
  example      String?
  wordType     String?
  pos          String?
  hskCode      String?
  hskLevel     Int?
  variants     String?
  cedict       String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  isKeyword    Boolean                  @default(false)
  userProgress UserVocabularyProgress[]
  conversationVocabularies ConversationVocabulary[]
  lesson       Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([hskLevel])
  @@index([hskCode])
  @@map("vocabularies")
}

model Conversation {
  id             String              @id @default(cuid())
  lessonId       String
  order          Int
  hanzi          String
  pinyin         String
  vietnamese     String
  audioUrl       String?
  difficulty     Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  speaker                String?
  // 课文 grouping (book prints 3-4 titled dialogues per lesson, e.g. 01-1 在学校)
  dialogueOrder          Int?
  dialogueTitleHanzi     String?
  dialogueTitleVi        String?
  lesson                 Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  conversationVocabularies ConversationVocabulary[]

  @@index([lessonId])
  @@index([lessonId, order])
  @@map("conversations")
}

model ConversationVocabulary {
  id             String       @id @default(cuid())
  conversationId String
  vocabularyId   String
  position       Int?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  vocabulary     Vocabulary   @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([conversationId, vocabularyId])
  @@index([conversationId])
  @@index([vocabularyId])
  @@map("conversation_vocabularies")
}

model UserVocabularyProgress {
  id             String     @id @default(cuid())
  userId         String
  vocabularyId   String
  masteryLevel   Int        @default(0)
  reviewCount    Int        @default(0)
  correctCount   Int        @default(0)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  isMastered     Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary     Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId, nextReviewAt])
  @@index([userId, isMastered])
  @@map("user_vocabulary_progress")
}

// Dialogue (conversation) spaced repetition. Stage drives the review interval:
// 0→+1d, 1→+3d, 2→+7d, 3→+14d; stage 4 = graduated (no further schedule).
model UserDialogueProgress {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  stage          Int       @default(0)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, nextReviewAt])
  @@map("user_dialogue_progress")
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_progress")
}

// Cache row for one synthesized TTS audio file. Audio is immutable — a changed
// synthesis parameter (text, voice, speed, pause, format) yields a new cacheKey.
// Files live on disk under TTS_STORAGE_DIR; this table only maps key → file.
model TtsAudio {
  id           String   @id @default(cuid())
  cacheKey     String   @unique
  type         String // 'text' | 'dialogue'
  text         String // plain text, or JSON array of dialogue lines
  voice        String // primary voice; for dialogue, JSON array of voices
  locale       String   @default("zh-CN")
  speed        Float    @default(1.0)
  pauseMs      Int?
  outputFormat String   @default("audio-24khz-48kbitrate-mono-mp3")
  filePath     String
  charCount    Int
  createdAt    DateTime @default(now())

  @@map("tts_audio")
}
